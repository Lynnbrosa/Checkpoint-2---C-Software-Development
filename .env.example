# Copie este arquivo para .env antes de executar o docker compose e preencha os valores locais.
# Nunca versione o arquivo .env real com senhas preenchidas.

EXPENSEHUB_WEB_IMAGE=ghcr.io/lynnbrosa/expensehub-web:<commit-final>
EXPENSEHUB_WORKER_IMAGE=ghcr.io/lynnbrosa/expensehub-worker:<commit-final>
WEB_PORT=5245
ASPNETCORE_ENVIRONMENT=Development
SEED_ADMIN_EMAIL=admin@expensehub.local
SEED_ADMIN_PASSWORD=<replace-with-strong-admin-password>
RABBITMQ_USER=guest
RABBITMQ_PASS=<replace-with-rabbitmq-password>

