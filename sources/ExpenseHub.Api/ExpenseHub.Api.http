@ExpenseHub_Api_HostAddress = http://localhost:5245
# troque pelo valor configurado em Seed:Admin:Password (não commite a senha real)
@adminPassword = <senha do seed>
# usuário comum já cadastrado e com a role Employee dada pelo Admin
@employeeEmail = funcionario@expensehub.local
@employeePassword = <senha do funcionario>
# outro usuário, com a role Approver dada pelo Admin
@approverEmail = aprovador@expensehub.local
@approverPassword = <senha do aprovador>
# usuário com a role Finance
@financeEmail = financeiro@expensehub.local
@financePassword = <senha do financeiro>

GET {{ExpenseHub_Api_HostAddress}}/health
Accept: application/json

### Login do Admin
# @name adminLogin
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "admin@expensehub.local",
  "password": "{{adminPassword}}"
}

###
@adminToken = {{adminLogin.response.body.$.accessToken}}

### Quem sou eu
GET {{ExpenseHub_Api_HostAddress}}/me
Authorization: Bearer {{adminToken}}

### Sem token: 401
GET {{ExpenseHub_Api_HostAddress}}/me

### Cadastro público (nasce sem role)
# @name register
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "{{employeeEmail}}",
  "password": "{{employeePassword}}",
  "fullName": "Funcionário de Teste"
}

###
@newUserId = {{register.response.body.$.id}}

### Cadastro tentando escolher role: 400
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "espertinho@expensehub.local",
  "password": "{{employeePassword}}",
  "roles": ["Admin"]
}

### Admin lista usuários
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminToken}}

### Admin dá a role Employee (o usuário precisa logar de novo depois)
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{newUserId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Employee"]
}

### Role desconhecida: 400
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{newUserId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Chefe"]
}

### Login de um Employee
# @name employeeLogin
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{employeeEmail}}",
  "password": "{{employeePassword}}"
}

###
@employeeToken = {{employeeLogin.response.body.$.accessToken}}

### Criar rascunho
# @name createExpense
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Táxi do aeroporto até o cliente",
  "amount": 87.50,
  "expenseDate": "2026-09-20",
  "categoryId": 1
}

###
@expenseId = {{createExpense.response.body.$.id}}

### Tentar informar o dono: 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Táxi do aeroporto até o cliente",
  "amount": 87.50,
  "expenseDate": "2026-09-20",
  "categoryId": 1,
  "ownerId": "outro-usuario"
}

### Valor, descrição e data inválidos: 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "curta",
  "amount": 0,
  "expenseDate": "2999-01-01",
  "categoryId": 1
}

### Editar o rascunho
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Táxi do aeroporto até o escritório do cliente",
  "amount": 92.30,
  "expenseDate": "2026-09-20",
  "categoryId": 1
}

### Listar conforme o perfil
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}

### Detalhe
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeToken}}

### Enviar para aprovação
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{employeeToken}}

### Enviar de novo: 409
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{employeeToken}}

### Admin sem outra role não lê reembolso: 403
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{adminToken}}

### Login de um Approver
# @name approverLogin
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{approverEmail}}",
  "password": "{{approverPassword}}"
}

###
@approverToken = {{approverLogin.response.body.$.accessToken}}

### Approver lista os enviados
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{approverToken}}

### Aprovar
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{approverToken}}

### Aprovar de novo: 409
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{approverToken}}

### Employee tentando aprovar: 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{employeeToken}}

### Reprovar sem justificativa válida: 400 (use um reembolso Submitted)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "curta"
}

### Reprovar com justificativa (use um reembolso Submitted)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "Nota fiscal ilegível, reenviar com comprovante."
}

### Login do Finance
# @name financeLogin
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{financeEmail}}",
  "password": "{{financePassword}}"
}

###
@financeToken = {{financeLogin.response.body.$.accessToken}}

### Finance lista aprovados e pagos
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{financeToken}}

### Pagar (reembolso Approved)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{financeToken}}

### Pagar de novo: 409
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{financeToken}}

### Histórico visto pelo dono
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{employeeToken}}

### Histórico visto pelo Approver depois do pagamento: 404
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{approverToken}}
